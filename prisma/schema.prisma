generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  REGISTER
  LOGIN_2FA
  PASSWORD_RESET
  EMAIL_CHANGE
  PHONE_CHANGE
}

enum TwoFactorChannel {
  EMAIL
  PHONE
}

enum VerificationBadge {
  NONE
  VERIFIED
  PREMIUM
}

enum MediaQuality {
  high
  medium
  low
}

enum ContactVisibility {
  PUBLIC
  PRIVATE
  HIDDEN
}

enum ListingStatus {
  AVAILABLE
  RENTED
  SOLD
}

enum PricePeriod {
  PER_YEAR
  PER_MONTH
  FOR_SALE
  NEGOTIABLE
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MessageKind {
  TEXT
  MEDIA
  VOICE
  CALL
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  MISSED
  DECLINED
  COMPLETED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model User {
  id                 String               @id @default(cuid())
  profileId          String               @unique
  fullName           String
  username           String?              @unique
  email              String?              @unique
  phone              String?              @unique
  passwordHash       String?
  googleId           String?              @unique
  imageUrl           String?
  bannerImageUrl     String?
  bio                String?
  whatsappUrl        String?
  instagramUrl       String?
  linkedinUrl        String?
  mediaQuality       MediaQuality         @default(high)
  emailVisibility    ContactVisibility    @default(PRIVATE)
  phoneVisibility    ContactVisibility    @default(PRIVATE)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  verificationBadge  VerificationBadge    @default(NONE)
  isTwoFactorEnabled Boolean              @default(false)
  twoFactorChannel   TwoFactorChannel     @default(EMAIL)
  deleteScheduledAt  DateTime?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  activeSessions     ActiveSession[]
  verificationTokens VerificationToken[]
  listings           Listing[]
  ratingsGiven       Rating[]             @relation("ratingsGiven")
  ratingsReceived    Rating[]             @relation("ratingsReceived")
  profileViews       ProfileView[]        @relation("profileViewsReceived")
  profileViewedBy    ProfileView[]        @relation("profileViewsByViewer")
  comments           Comment[]
  commentLikes       CommentLike[]
  messagesSent       Message[]            @relation("messagesSent")
  messagesReceived   Message[]            @relation("messagesReceived")
  passwordResetTokens PasswordResetToken[]
  listingLikes       ListingLike[]
  listingSaves       ListingSave[]
  listingFavorites   ListingFavorite[]
  listingViews       ListingView[]
  conversationsStarted Conversation[]      @relation("conversationStarter")
  conversationsReceived Conversation[]     @relation("conversationRecipient")
  conversationParticipants ConversationParticipant[]
  messageReads       MessageRead[]
  blocksMade         UserBlock[]           @relation("blocksMade")
  blocksReceived     UserBlock[]           @relation("blocksReceived")
  reportsMade        UserReport[]          @relation("reportsMade")
  reportsReceived    UserReport[]          @relation("reportsReceived")
}

model VerificationToken {
  id            String              @id @default(cuid())
  userId        String
  identifier    String
  channel       VerificationChannel
  purpose       VerificationPurpose
  codeHash      String
  linkTokenHash String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime            @default(now())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose])
  @@index([userId, purpose])
}

model ActiveSession {
  id         String    @id @default(cuid())
  userId     String
  jti        String    @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String
  isSystem  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  listings  Listing[]
}

model Listing {
  id          String       @id @default(cuid())
  ownerId     String
  categoryId  String
  title       String
  description String
  price       Int
  pricePeriod PricePeriod   @default(PER_YEAR)
  locationText String       @default("")
  latitude    Float?
  longitude   Float?
  status      ListingStatus @default(AVAILABLE)
  expiresAt   DateTime?
  viewsCount  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category    Category      @relation(fields: [categoryId], references: [id])
  mediaItems  ListingMedia[]
  comments    Comment[]
  likes       ListingLike[]
  saves       ListingSave[]
  favorites   ListingFavorite[]
  views       ListingView[]
  conversations Conversation[]
  messages    Message[]
  reports     UserReport[]

  @@index([ownerId, createdAt])
  @@index([categoryId, createdAt])
  @@index([price, createdAt])
  @@index([status, createdAt])
}

model ListingMedia {
  id         String    @id @default(cuid())
  listingId  String
  kind       MediaKind @default(IMAGE)
  url        String
  publicId   String?
  mimeType   String?
  sizeBytes  Int?
  originalName String?
  quality    MediaQuality @default(high)
  width      Int?
  height     Int?
  position   Int       @default(0)
  createdAt  DateTime  @default(now())
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

model ListingLike {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId, createdAt])
}

model ListingSave {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId, createdAt])
}

model ListingFavorite {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId, createdAt])
}

model ListingView {
  id        String   @id @default(cuid())
  listingId String
  viewerIp  String
  userId    String?
  viewedAt  DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId, viewedAt])
  @@index([userId, viewedAt])
}

model Rating {
  id          String   @id @default(cuid())
  raterId     String
  ratedUserId String
  score       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rater       User     @relation("ratingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUser   User     @relation("ratingsReceived", fields: [ratedUserId], references: [id], onDelete: Cascade)

  @@unique([raterId, ratedUserId])
  @@index([ratedUserId])
}

model ProfileView {
  id            String   @id @default(cuid())
  profileUserId String
  viewerIp      String
  viewerUserId  String?
  viewedAt      DateTime @default(now())
  profileUser   User     @relation("profileViewsReceived", fields: [profileUserId], references: [id], onDelete: Cascade)
  viewerUser    User?    @relation("profileViewsByViewer", fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@index([profileUserId, viewedAt])
}

model Comment {
  id         String       @id @default(cuid())
  listingId  String
  authorId   String
  body       String
  parentId   String?
  likesCount Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?     @relation("commentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Comment[]    @relation("commentReplies")
  likes      CommentLike[]

  @@index([listingId, createdAt])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Message {
  id          String       @id @default(cuid())
  conversationId String?
  listingId   String?
  senderId    String
  recipientId String
  kind        MessageKind  @default(TEXT)
  body        String
  mediaUrl    String?
  mediaMimeType String?
  mediaName   String?
  deliveredAt DateTime?
  seenAt      DateTime?
  deletedForEveryoneAt DateTime?
  deletedForSenderAt DateTime?
  deletedForRecipientAt DateTime?
  createdAt   DateTime     @default(now())
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  listing     Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  sender      User         @relation("messagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User         @relation("messagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, recipientId, createdAt])
}

model Conversation {
  id          String   @id @default(cuid())
  starterId   String
  recipientId String
  listingId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  starter     User     @relation("conversationStarter", fields: [starterId], references: [id], onDelete: Cascade)
  recipient   User     @relation("conversationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages    Message[]
  reads       MessageRead[]
  calls       CallLog[]

  @@index([starterId, updatedAt])
  @@index([recipientId, updatedAt])
  @@index([listingId])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  archivedAt     DateTime?
  mutedAt        DateTime?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, createdAt])
}

model MessageRead {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  readAt         DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model CallLog {
  id             String     @id @default(cuid())
  conversationId String
  callerId       String
  recipientId    String
  type           CallType
  status         CallStatus
  startedAt      DateTime   @default(now())
  endedAt        DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())
  blocker   User     @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model UserReport {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  listingId  String?
  messageId  String?
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  reporter   User         @relation("reportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User         @relation("reportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  listing    Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([reportedId, status])
  @@index([reporterId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
